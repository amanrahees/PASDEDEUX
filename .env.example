# Django application
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Local service ports
WEB_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# PostgreSQL
POSTGRES_DB=pasdedeux
POSTGRES_USER=pasdedeux
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql://pasdedeux:replace-with-a-local-database-password@127.0.0.1:5433/pasdedeux
DB_CONN_MAX_AGE=60

# Redis cache and API throttling
REDIS_URL=redis://127.0.0.1:6380/0
CACHE_KEY_PREFIX=pasdedeux
CACHE_DEFAULT_TIMEOUT=300

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6380/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/2
CELERY_TASK_SOFT_TIME_LIMIT=270
CELERY_TASK_TIME_LIMIT=300
CELERY_RESULT_EXPIRES=3600
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# API authentication and throttling
JWT_SIGNING_KEY=replace-with-a-separate-long-random-secret
JWT_ACCESS_MINUTES=10
AUTH_SESSION_DAYS=30
AUTH_RATE=20/hour
AUTH_REFRESH_RATE=120/hour
AUTH_EMAIL_RATE=10/hour
AUTH_PASSWORD_RATE=10/hour
EMAIL_VERIFICATION_OTP_TTL_SECONDS=600
EMAIL_VERIFICATION_OTP_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_OTP_MAX_ATTEMPTS=5
AUTH_FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=3600
API_ANON_RATE=100/hour
API_USER_RATE=1000/hour

# Email delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="PASDEDEUX <no-reply@pasdedeux.app>"

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STOCK_RESERVATION_MINUTES=15
STORE_COUNTRY_CODE=IN
DOMESTIC_FREE_SHIPPING_THRESHOLD=1999.00
DOMESTIC_SHIPPING_RATE=99.00
INTERNATIONAL_SHIPPING_RATE=1499.00
LOW_STOCK_THRESHOLD=5
LOW_STOCK_NOTIFICATION_EMAILS=
MAX_PRODUCT_IMAGE_BYTES=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
MEDIA_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage

# Browser clients
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CSRF_TRUSTED_ORIGINS=http://localhost:3000
